# Azure OpenAI credentials (Required)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION="2025-03-01-preview"
GROQ_API_KEY=

# Azure OpenAI model deployment names (must match the deployment names in your Azure OpenAI resource)
TRANSCRIBE_DEPLOYMENT="whisper-1"
CHAT_DEPLOYMENT="gpt-5.6-terra"
# Depth of internal reasoning for reasoning-capable models
REASONING_EFFORT="medium"

# Storage Settings (Set to 'false' to use Google Drive (requires service_account.json in /backend))
LOCAL_STORAGE_MODE=true
GOOGLE_SERVICE_ACCOUNT_JSON=

# Real-time classification
REALTIME_CLASSIFICATION=false

# The ID of the Google Drive folder where data should be stored
GOOGLE_DRIVE_FOLDER_ID=

# CORS Settings (Separate variables for different environments)
ALLOWED_ORIGIN_LOCAL="http://127.0.0.1:3000"
ALLOWED_ORIGIN_DOCKER="http://localhost"
ALLOWED_ORIGIN_DOCKER_2="http://127.0.0.1"
ALLOWED_ORIGIN_HOSTED="https://sevyge.github.io"

# Password for the researcher annotation tool (optional, leave blank to disable check locally)
RESEARCHER_TOKEN=

TZ="Europe/Brussels"